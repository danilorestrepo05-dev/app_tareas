# Copia este archivo como `.streamlit/secrets.toml` y rellena los valores.
# Está en .gitignore: nunca subir secretos reales al repositorio.

# --- Identidad (login con Google vía st.login) ---
# En Community Cloud una app con autenticación cuenta como la única "app privada".
[auth]
redirect_uri = "https://TOKEN.env.app.streamlit.app/oauth2callback"
cookie_secret = "PON_UN_SECRETO_LARGO_ALEATORIO"

[auth.google]
client_id = "XXXXXXXXXXXX-xxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"